// #region Imports
import { randomUUID } from 'node:crypto';
import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import {
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { {{upperCamelCaseName}}Repository } from './{{dashCaseName}}.server.repository';
import {
  {{upperCamelCaseName}}Schema,
  {{upperCamelCaseName}}StoreSchema,
} from './{{dashCaseName}}.server.schema';
import type {
  Create{{upperCamelCaseName}},
  {{upperCamelCaseName}},
  {{upperCamelCaseName}}Store,
} from './{{dashCaseName}}.server.schema';
// #endregion

// #region Adapter
@Injectable()
export class {{upperCamelCaseName}}JsonAdapter extends {{upperCamelCaseName}}Repository {
  private readonly dataDirectory = process.env['DATA_DIR'] ?? '.dist/data';
  private readonly dataFile = join(
    this.dataDirectory,
    '{{dashCaseName}}.json',
  );
  private writeQueue: Promise<void> = Promise.resolve();
  private initialization: Promise<{{upperCamelCaseName}}Store> | undefined;

  public async getAll(): Promise<{{upperCamelCaseName}}[]> {
    return (await this.readStore()).records;
  }

  public async getById(id: string): Promise<{{upperCamelCaseName}}> {
    const record = (await this.readStore()).records.find(
      (item) => item.id === id,
    );
    if (!record) throw new NotFoundException('Record not found');
    return record;
  }

  public async create(
    input: Create{{upperCamelCaseName}},
  ): Promise<{{upperCamelCaseName}}> {
    return this.updateStore((store) => {
      const record = {{upperCamelCaseName}}Schema.parse({
        ...input,
        id: randomUUID(),
      });
      store.records.push(record);
      return record;
    });
  }

  public async update(
    id: string,
    input: Create{{upperCamelCaseName}},
  ): Promise<{{upperCamelCaseName}}> {
    return this.updateStore((store) => {
      const index = store.records.findIndex((item) => item.id === id);
      if (index < 0) throw new NotFoundException('Record not found');
      const record = {{upperCamelCaseName}}Schema.parse({
        ...input,
        id,
      });
      store.records[index] = record;
      return record;
    });
  }

  public async delete(id: string): Promise<{{upperCamelCaseName}}> {
    return this.updateStore((store) => {
      const index = store.records.findIndex((item) => item.id === id);
      if (index < 0) throw new NotFoundException('Record not found');
      return store.records.splice(index, 1)[0]!;
    });
  }

  private async readStore(): Promise<{{upperCamelCaseName}}Store> {
    await mkdir(this.dataDirectory, { recursive: true });
    try {
      return {{upperCamelCaseName}}StoreSchema.parse(
        JSON.parse(await readFile(this.dataFile, 'utf8')),
      );
    } catch (error: unknown) {
      if (!isMissingFile(error)) throw error;
      return this.initializeStore();
    }
  }

  private initializeStore(): Promise<{{upperCamelCaseName}}Store> {
    if (!this.initialization) {
      this.initialization = (async () => {
        const store = {{upperCamelCaseName}}StoreSchema.parse({
          version: 1,
          records: [],
        });
        await this.writeStore(store);
        return store;
      })();
    }
    return this.initialization;
  }

  private async updateStore<T>(
    operation: (store: {{upperCamelCaseName}}Store) => T,
  ): Promise<T> {
    const result = this.writeQueue.then(async () => {
      const store = await this.readStore();
      const value = operation(store);
      await this.writeStore(store);
      return value;
    });
    this.writeQueue = result.then(
      () => undefined,
      () => undefined,
    );
    return result;
  }

  private async writeStore(store: {{upperCamelCaseName}}Store): Promise<void> {
    await mkdir(this.dataDirectory, { recursive: true });
    const temporaryFile = `${this.dataFile}.${randomUUID()}.tmp`;
    await writeFile(temporaryFile, `${JSON.stringify(store, null, 2)}\n`, {
      encoding: 'utf8',
      mode: 0o600,
    });
    await rename(temporaryFile, this.dataFile);
  }
}
// #endregion

// #region Helpers
function isMissingFile(error: unknown): boolean {
  return (
    typeof error === 'object' &&
    error !== null &&
    'code' in error &&
    error.code === 'ENOENT'
  );
}
// #endregion
